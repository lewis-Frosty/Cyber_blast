# Build-time configuration for deployed builds (Vercel, and any static host).
#
# COMMITTED ON PURPOSE. Vite inlines VITE_* variables into the client bundle at
# build time, so these two values are public the moment the game ships either
# way — reading them out of the deployed JavaScript is trivial. Keeping them in
# the repo means a deploy works with no dashboard configuration, and removes the
# failure mode where the site builds fine but every run silently plays offline
# because the build had no backend configured.
#
# The publishable key carries no privileges of its own: every table is governed
# by row level security, and the anti-cheat chokepoint is the Edge Function. The
# service_role key is what must never appear here — it bypasses RLS entirely and
# lives only in Edge Function secrets.
VITE_SUPABASE_URL=https://iniuyjwgnqlieidvhxtf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable__DARbnDT57kgK93iWAsMGQ_FUsLeaGy
