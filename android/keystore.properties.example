# Copy to android/keystore.properties and fill in. NEVER COMMIT the real file
# or the .jks it points at — both are gitignored.
#
# Generate the upload key (JDK's keytool, once — then back it up somewhere you
# will still have in five years):
#
#   keytool -genkeypair -v \
#     -keystore cyber-blast-upload.jks \
#     -alias cyber-blast-upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# This is the UPLOAD key, not the app signing key. Enrol in Play App Signing on
# the first release and Google holds the signing key: if this upload key is
# ever lost, Play support can reset it. Without Play App Signing, losing the
# key means you can never update the app again.

storeFile=/absolute/path/to/cyber-blast-upload.jks
storePassword=CHANGE_ME
keyAlias=cyber-blast-upload
keyPassword=CHANGE_ME
